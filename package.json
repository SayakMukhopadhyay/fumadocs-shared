{
  "name": "@sayakm/fumadocs-shared",
  "version": "0.1.0",
  "description": "Shared Fumadocs components for Sayak's projects.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles/index.css"
  },
  "files": ["dist", "styles"],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "build:dist": "npm run clean && tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "validate:generated": "git diff --exit-code -- dist"
  },
  "dependencies": {
    "@types/d3": "7.4.3",
    "d3": "7.9.2",
    "mermaid": "12.3.0"
  },
  "peerDependencies": {
    "fumadocs-core": "16.18.4",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.18.4",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "fumadocs-core": "16.18.4",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.18.4",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3"
  }
}
